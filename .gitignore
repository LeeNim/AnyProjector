# --- Documentation, Thesis, Notes (results/artifacts, not source) ---
Docs and more/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
eggs/
*.whl

# --- Virtual Environments ---
venv/
.venv/
env/
.env
.env/

# --- IDE & Editor ---
.agents/
.agent/
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Jupyter ---
.ipynb_checkpoints/

# --- PyTorch / ML Model Weights ---
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
wandb/
runs/
outputs/

# --- Training Artifacts (results, not scripts) ---
logs/
checkpoint/
projectorTrained/
lora/
results/
training_analysis/

# --- Data & Dataset (too large for git) ---
dataset/
data/

# --- Scratch / Temp / One-off ---
scratch/
*.tmp
*.log
*.zip

# --- Result files (generated output, not source) ---
bestmodel_log.txt
eval_trace.txt
_eval_error.txt
evaluation_results.json
evaluation_train_set.json
whisper_cache.json
dataset_info.json
next_100.json
next_50.json
PROGRESS.md
scripts/demo_log.csv

# --- Colab session artifacts ---
511f5ca9-*/
511f5ca9-*.zip

# --- Hugging Face Cache ---
.cache/

# --- Modelfile (Ollama-specific, local only) ---
Modelfile

# --- Utility scripts (one-off, not core) ---
check_disk.ps1